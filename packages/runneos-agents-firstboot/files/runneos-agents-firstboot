#!/usr/bin/python3
"""Онбординг агентов RunneOS: подключение провайдеров при первом входе в сеанс.

Запускается пользовательским юнитом `runneos-agents-firstboot.service` при первом
входе (маркер однократности: `~/.local/state/runneos/agents-firstboot/done`).
Показывает состояние провайдеров (`runneos-agents provider auth-status --json`),
для неавторизованных предлагает штатный вход: кнопка открывает runneos-terminal
с `codex login` / `opencode auth login`. Сам диалог ничего не авторизует и ключей
не хранит: вход выполняет штатный CLI провайдера, ключ остаётся у провайдера.

Закрытие окна любым способом пишет маркер — диалог не навязывается повторно.
Вернуть его: `runneos-agents-firstboot --reset` и запустить снова, либо просто
запустить команду без аргументов в любой момент.

Проверка без дисплея (QEMU-стенд, серийная консоль):

    runneos-agents-firstboot --smoke-test   # JSON: провайдеры, маркер; код 0/1

Отсутствие CLI, провайдеров или дисплея — честное сообщение, а не падение.
"""
from __future__ import annotations

import argparse
import json
import os
import shlex
import subprocess
import sys
import threading
from pathlib import Path

__version__ = "0.1.0"

CLI = "runneos-agents"
TERMINAL = "runneos-terminal"
PANEL = "runneos-agents-panel"
# Внутри CLI каждый адаптер ждёт свою проверку до 10 с; на двух провайдерах это до 20 с,
# плюс запуск python. Диалог честно ждёт, но не бесконечно.
STATUS_TIMEOUT = 30.0
MARKER_RELATIVE = Path("runneos") / "agents-firstboot" / "done"

APP_ID = "org.runneos.AgentsFirstboot"
WINDOW_TITLE = "Агенты RunneOS · первый вход"

EXIT_OK = 0
EXIT_ERROR = 1
EXIT_USAGE = 2


# --- чистая логика: без GTK, проверяется tests/test_firstboot_agents.py ------


def marker_path(state_home: str | os.PathLike | None = None) -> Path:
    """Файл-маркер однократности в XDG_STATE_HOME пользователя."""
    root = Path(state_home or os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state")
    return Path(root) / MARKER_RELATIVE


def marker_exists(state_home: str | os.PathLike | None = None) -> bool:
    return marker_path(state_home).exists()


def write_marker(state_home: str | os.PathLike | None = None) -> bool:
    """Записать маркер. False — записать не удалось (это не ошибка сеанса)."""
    path = marker_path(state_home)
    try:
        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        path.write_text("", encoding="utf-8")
    except OSError:
        return False
    return True


def reset_marker(state_home: str | os.PathLike | None = None) -> bool:
    """Убрать маркер, чтобы диалог показался снова. False — маркера и не было."""
    try:
        marker_path(state_home).unlink()
    except FileNotFoundError:
        return False
    except OSError:
        return False
    return True


def collect_status(
    cli: str = CLI, timeout: float = STATUS_TIMEOUT
) -> tuple[list[dict], str]:
    """Строки `runneos-agents provider auth-status --json` и причина сбоя, если он был."""
    try:
        done = subprocess.run(
            [cli, "provider", "auth-status", "--json"],
            capture_output=True,
            text=True,
            timeout=timeout,
            check=False,
        )
    except FileNotFoundError:
        return [], f"{cli} не найден: установлен ли пакет runneos-agents?"
    except subprocess.TimeoutExpired:
        return [], f"{cli} не ответил за {timeout:.0f} с"
    except OSError as error:
        return [], f"запуск {cli} не удался: {type(error).__name__}"
    if done.returncode != 0:
        text = (done.stderr or done.stdout or "").strip()
        suffix = f": {text[:200]}" if text else ""
        return [], f"{cli} вернул код {done.returncode}{suffix}"
    rows: list[dict] = []
    for line in (done.stdout or "").splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            row = json.loads(line)
        except ValueError:
            continue  # мусорная строка не отменяет остальные
        if isinstance(row, dict) and row.get("provider"):
            rows.append(row)
    return rows, ""


def row_view(row: dict) -> tuple[str, bool, str]:
    """(состояние, есть ли кнопка «Подключить», пояснение) для строки провайдера."""
    if not row.get("binary_present"):
        detail = str(row.get("detail") or "").strip() or "бинаря нет в системе"
        return "не найден", False, detail
    authorized = row.get("authorized")
    how = str(row.get("how") or "").strip()
    detail = str(row.get("detail") or "").strip()
    if authorized is True:
        return "подключён", False, detail
    if authorized is None:
        return "неизвестно", False, detail or "состояние входа определить не удалось"
    if not how:
        return "не авторизован", False, detail or "штатная команда входа неизвестна"
    text = f"штатный вход: {how}"
    if detail:
        text += f" — {detail}"
    return "не авторизован", True, text


def connect_argv(row: dict, terminal: str = TERMINAL) -> list[str] | None:
    """Команда «открыть штатный вход в терминале» или None, если подключать нечего."""
    how = str(row.get("how") or "").strip()
    parts = shlex.split(how)
    if not parts:
        return None
    return [terminal, "-e", *parts]


def smoke_payload(cli: str = CLI) -> dict:
    """Снимок для --smoke-test: состояние провайдеров и маркер, без GTK."""
    rows, error = collect_status(cli)
    return {
        "version": __version__,
        "ok": not error,
        "error": error,
        "marker": {"path": str(marker_path()), "exists": marker_exists()},
        "providers": rows,
    }


# --- GTK: окно строится лениво, чтобы --smoke-test работал без дисплея -------


def _import_gtk():
    import gi

    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Adw, GLib, Gtk

    return Adw, Gtk, GLib


class FirstbootWindow:
    """Диалог онбординга: состояния провайдеров, штатный вход в терминале, маркер.

    Вся сборка в одном классе, чтобы пересоздание после входа («Обновить статус»)
    было честным: окно закрывается и строится заново с новыми состояниями.
    """

    def __init__(self, app, Adw, Gtk, GLib, *, cli: str = CLI, terminal: str = TERMINAL) -> None:
        self.app = app
        self.Adw, self.Gtk, self.GLib = Adw, Gtk, GLib
        self.cli = cli
        self.terminal = terminal
        self.finished = False
        self._terminal_process: subprocess.Popen | None = None

        rows, error = collect_status(cli)
        views = [(row, *row_view(row)) for row in rows]

        self.window = Adw.Window(title=WINDOW_TITLE)
        self.window.set_default_size(560, 380)

        header = Adw.HeaderBar()
        title = Gtk.Label(label=WINDOW_TITLE)
        title.add_css_class("title")
        header.set_title_widget(title)

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        content.set_margin_top(12)
        content.set_margin_bottom(12)
        content.set_margin_start(12)
        content.set_margin_end(12)

        intro = Gtk.Label(
            label=(
                "Задачи агентам выполняют провайдеры через вашу подписку. "
                "Подключите хотя бы одного: вход штатный, ключ остаётся у провайдера."
            )
        )
        intro.set_wrap(True)
        intro.set_xalign(0)
        intro.add_css_class("dim-label")
        content.append(intro)

        if error:
            note = Gtk.Label(label=f"Состояние провайдеров узнать не удалось: {error}")
            note.set_wrap(True)
            note.set_xalign(0)
            note.add_css_class("error")
            content.append(note)
        elif not views:
            empty = Gtk.Label(
                label=(
                    "Провайдеров, известных ядру, нет. "
                    "Поставьте codex или opencode (пакет runneos-ai-providers)."
                )
            )
            empty.set_wrap(True)
            empty.set_xalign(0)
            content.append(empty)

        self.connect_buttons: list[Gtk.Button] = []
        for row, state, connectable, subtitle in views:
            line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            name = Gtk.Label(label=f"{row.get('provider')}: {state}")
            name.set_xalign(0)
            name.set_hexpand(True)
            if subtitle:
                name.set_tooltip_text(subtitle)
            line.append(name)
            if connectable:
                argv = connect_argv(row, terminal)
                if argv:
                    button = Gtk.Button(label="Подключить")
                    button.connect("clicked", self._on_connect, argv)
                    line.append(button)
                    self.connect_buttons.append(button)
            content.append(line)

        self.note = Gtk.Label(label="")
        self.note.set_wrap(True)
        self.note.set_xalign(0)
        content.append(self.note)

        buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        buttons.set_halign(Gtk.Align.END)
        if PANEL:
            panel_button = Gtk.Button(label="Открыть панель агентов")
            panel_button.connect("clicked", self._on_open_panel)
            buttons.append(panel_button)
        done = Gtk.Button(label="Готово")
        done.add_css_class("suggested-action")
        done.connect("clicked", self._finish)
        buttons.append(done)
        content.append(buttons)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        root.append(header)
        root.append(content)
        self.window.set_content(root)
        self.window.connect("close-request", self._finish)

    # --- действия

    def present(self) -> None:
        self.window.present()

    def _on_connect(self, button, argv: list[str]) -> None:
        for item in self.connect_buttons:
            item.set_sensitive(False)
        self.note.set_text("Открыт штатный вход в терминале; по завершении статус обновится.")
        try:
            self._terminal_process = subprocess.Popen(
                argv, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
            )
        except OSError as error:
            self.note.set_text(f"Терминал открыть не удалось: {type(error).__name__}: {error}")
            return
        thread = threading.Thread(target=self._wait_terminal, daemon=True, name="firstboot-terminal")
        thread.start()

    def _wait_terminal(self) -> None:
        process = self._terminal_process
        if process is not None:
            try:
                process.wait(timeout=1800)
            except Exception:  # noqa: BLE001 — терминал закрыт извне: не ошибка сеанса
                pass
        self.GLib.idle_add(self._rebuild_with_fresh_status)

    def _rebuild_with_fresh_status(self) -> bool:
        if self.finished:
            return False
        replacement = FirstbootWindow(
            self.app, self.Adw, self.Gtk, self.GLib, cli=self.cli, terminal=self.terminal
        )
        self.finished = True  # старое окно закрывается без записи маркера-поторопки
        self.app.add_window(replacement.window)
        replacement.present()
        self.window.destroy()
        return False

    def _on_open_panel(self, *_args) -> None:
        try:
            subprocess.Popen([PANEL], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError as error:
            self.note.set_text(f"Панель открыть не удалось: {type(error).__name__}: {error}")

    def _finish(self, *_) -> bool:
        """Закрытие любым способом пишет маркер однократности."""
        if not self.finished:
            write_marker()
            self.finished = True
        self.window.destroy()
        return True


def run_dialog(cli: str = CLI, terminal: str = TERMINAL) -> int:
    """Точка входа окна: приложение с одним диалогом; код 0 при штатном закрытии."""
    try:
        Adw, Gtk, GLib = _import_gtk()
    except Exception as error:  # noqa: BLE001 — без дисплея это штатная ситуация
        print(f"графический сеанс недоступен: {type(error).__name__}: {error}", file=sys.stderr)
        return EXIT_ERROR

    app = Adw.Application(application_id=APP_ID)

    def on_activate(application) -> None:
        window = FirstbootWindow(application, Adw, Gtk, GLib, cli=cli, terminal=terminal)
        application.add_window(window.window)
        window.present()

    app.connect("activate", on_activate)
    return app.run([]) or EXIT_OK


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="runneos-agents-firstboot",
        description="Онбординг агентов RunneOS: подключение провайдеров при первом входе.",
    )
    parser.add_argument("--version", action="version", version=f"runneos-agents-firstboot {__version__}")
    parser.add_argument("--smoke-test", action="store_true", help="JSON-снимок без окна (для стендов)")
    parser.add_argument("--reset", action="store_true", help="убрать маркер однократности")
    parser.add_argument("--cli", default=CLI, help="команда CLI агентов (по умолчанию runneos-agents)")
    args = parser.parse_args(argv)

    if args.reset:
        removed = reset_marker()
        print("маркер убран — диалог покажется при следующем входе" if removed else "маркера не было")
        return EXIT_OK
    if args.smoke_test:
        payload = smoke_payload(args.cli)
        print(json.dumps(payload, ensure_ascii=False))
        return EXIT_OK if payload["ok"] else EXIT_ERROR

    return run_dialog(args.cli)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("\nпрервано пользователем", file=sys.stderr)
        sys.exit(EXIT_ERROR)
