def import_core():
    """Импортирует ядро по контракту. Возвращает (Store, Orchestrator, причина)."""
    try:
        from runneos_agents import Store,Orchestrator
        return Store,Orchestrator,''
    except Exception as error:
        reason=f'{type(error).__name__}: {error}'
    try:
        from runneos_agents.store import Store
        from runneos_agents.orchestrator import Orchestrator
        return Store,Orchestrator,''
    except Exception as error:
        reason=f'{type(error).__name__}: {error}'
    return None,None,reason


